# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Sadece Vercel Cron kur güncellemesi kullanır; gizli tut
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic Claude API (ekstre okuma, rapor, danışman)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Virgülle ayrılmış e-posta listesi; boşsa giriş yapan herkes /finans'a erişir
FINANS_ALLOWED_EMAIL=you@example.com

# Vercel Cron günlük kur güncellemesi (/api/finans/cron/fx) için
CRON_SECRET=your_random_secret

# Sadece geliştirmede: 1 ise /finans Supabase olmadan örnek veriyle açılır
# FINANS_DEMO=1
